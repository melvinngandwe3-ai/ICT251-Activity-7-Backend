# Copy this file to .env locally. Never commit your real .env file.
DATABASE_URL=postgresql://username:password@localhost:5432/it_support
PORT=3000
# Comma-separated browser origins. * is suitable for a public classroom demo.
CLIENT_ORIGINS=*
# Set true when the hosted PostgreSQL provider requires SSL.
DB_SSL=false
# Set this to the public HTTPS service URL after deployment.
PUBLIC_BASE_URL=http://localhost:3000